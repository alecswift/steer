{
  "uid": "steer",
  "title": "Steer",
  "description": "Steer product events, frontend errors and success criteria, plus backend request, query and memory metrics. Event counts and timings come from Loki event records, which are exact per event; browser counters in Prometheus miss the first increment of each page load.",
  "tags": ["steer"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "bargauge",
      "title": "Events by name",
      "description": "Product events (track) in the selected time range.",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "instant",
          "expr": "sum by (event_name) (count_over_time({service_name=\"steer-frontend\"} | event_name != \"\" [$__range]))",
          "legendFormat": "{{event_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "min": 0, "color": { "mode": "fixed", "fixedColor": "blue" } },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Events over time",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "range",
          "expr": "sum by (event_name) (count_over_time({service_name=\"steer-frontend\"} | event_name != \"\" [$__auto]))",
          "legendFormat": "{{event_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 1, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Map load time (app.loaded)",
      "description": "Time from navigation start until the map first finishes loading, over the selected time range.",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 6 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "instant",
          "expr": "quantile_over_time(0.5, {service_name=\"steer-frontend\"} | event_name=\"app.loaded\" | unwrap map_load_ms [$__range]) by (service_name)",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "instant",
          "expr": "quantile_over_time(0.95, {service_name=\"steer-frontend\"} | event_name=\"app.loaded\" | unwrap map_load_ms [$__range]) by (service_name)",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 3000 },
              { "color": "red", "value": 8000 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Map load time per page load",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 6 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "range",
          "expr": "max_over_time({service_name=\"steer-frontend\"} | event_name=\"app.loaded\" | unwrap map_load_ms [$__auto]) by (service_name)",
          "legendFormat": "load time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": { "drawStyle": "points", "pointSize": 8, "showPoints": "always" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "hidden", "placement": "bottom" }, "tooltip": { "mode": "single" } }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Peak details latency (SC-006)",
      "description": "Time from clicking a peak until its details panel has painted, over the selected time range. SC-006 target: p95 under 100 ms. From peak.panel_shown events; the steer.peak.select_to_panel_ms histogram carries the same values.",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 6 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "instant",
          "expr": "quantile_over_time(0.5, {service_name=\"steer-frontend\"} | event_name=\"peak.panel_shown\" | unwrap select_to_panel_ms [$__range]) by (service_name)",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "instant",
          "expr": "quantile_over_time(0.95, {service_name=\"steer-frontend\"} | event_name=\"peak.panel_shown\" | unwrap select_to_panel_ms [$__range]) by (service_name)",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 100 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Peak details latency (maximum per interval)",
      "description": "The line marks the 100 ms SC-006 target.",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 6 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "range",
          "expr": "max_over_time({service_name=\"steer-frontend\"} | event_name=\"peak.panel_shown\" | unwrap select_to_panel_ms [$__auto]) by (service_name)",
          "legendFormat": "latency"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "color": { "mode": "fixed", "fixedColor": "green" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "red", "value": 100 }
            ]
          },
          "custom": {
            "drawStyle": "points",
            "pointSize": 8,
            "showPoints": "always",
            "thresholdsStyle": { "mode": "line" }
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "hidden", "placement": "bottom" }, "tooltip": { "mode": "single" } }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Route select-to-fit latency (SC-003)",
      "description": "Time from clicking a route in the sidebar until the map first shows it and starts framing it, over the selected time range. SC-003 asks for no visible delay, taken here as p95 under 100 ms. From route.shown events; the steer.route.select_to_fit_ms histogram carries the same values.",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 6 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "instant",
          "expr": "quantile_over_time(0.5, {service_name=\"steer-frontend\"} | event_name=\"route.shown\" | unwrap select_to_fit_ms [$__range]) by (service_name)",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "instant",
          "expr": "quantile_over_time(0.95, {service_name=\"steer-frontend\"} | event_name=\"route.shown\" | unwrap select_to_fit_ms [$__range]) by (service_name)",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 100 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Route select-to-fit latency (maximum per interval)",
      "description": "The line marks the 100 ms SC-003 target.",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 6 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "range",
          "expr": "max_over_time({service_name=\"steer-frontend\"} | event_name=\"route.shown\" | unwrap select_to_fit_ms [$__auto]) by (service_name)",
          "legendFormat": "latency"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "color": { "mode": "fixed", "fixedColor": "green" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "red", "value": 100 }
            ]
          },
          "custom": {
            "drawStyle": "points",
            "pointSize": 8,
            "showPoints": "always",
            "thresholdsStyle": { "mode": "line" }
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "hidden", "placement": "bottom" }, "tooltip": { "mode": "single" } }
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Snap latency (SC-001)",
      "description": "Time from adding a point in the editor until its leg arrives from POST /api/snap, snapped or straight, over the selected time range. SC-001 target: p95 under 1000 ms. From snap.completed events; the browser's steer.snap.duration_ms histogram carries the same values. Requests that failed are counted as snap.failed instead.",
      "gridPos": { "x": 0, "y": 26, "w": 12, "h": 6 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "instant",
          "expr": "quantile_over_time(0.5, {service_name=\"steer-frontend\"} | event_name=\"snap.completed\" | unwrap duration_ms [$__range]) by (service_name)",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "instant",
          "expr": "quantile_over_time(0.95, {service_name=\"steer-frontend\"} | event_name=\"snap.completed\" | unwrap duration_ms [$__range]) by (service_name)",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1000 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Snap latency p95, browser and Phoenix",
      "description": "p95 of steer.snap.duration_ms as the browser sees it (including the network) and as Phoenix measures it (BRouter or the DEM fallback). The line marks the 1000 ms SC-001 target. The browser histogram misses the first leg of each page load.",
      "gridPos": { "x": 12, "y": 26, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(steer_snap_duration_ms_bucket{service_name=~\"steer-frontend|steer-backend\"}[$__rate_interval])))",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "red", "value": 1000 }
            ]
          },
          "custom": {
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": { "mode": "line" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 17,
      "type": "stat",
      "title": "Time to save a new route (SC-002)",
      "description": "Time from Create route until the route is saved, over the selected time range. SC-002 target: under 120 s. From route.saved events (mode new); the browser's steer.editor.time_to_save_s histogram carries the same values. Saves that failed are counted as route.save_failed instead.",
      "gridPos": { "x": 0, "y": 32, "w": 12, "h": 6 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "instant",
          "expr": "quantile_over_time(0.5, {service_name=\"steer-frontend\"} | event_name=\"route.saved\" | mode=\"new\" | unwrap time_to_save_s [$__range]) by (service_name)",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "instant",
          "expr": "quantile_over_time(0.95, {service_name=\"steer-frontend\"} | event_name=\"route.saved\" | mode=\"new\" | unwrap time_to_save_s [$__range]) by (service_name)",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 120 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Time to save a new route (maximum per interval)",
      "description": "The line marks the 120 s SC-002 target.",
      "gridPos": { "x": 12, "y": 32, "w": 12, "h": 6 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "range",
          "expr": "max_over_time({service_name=\"steer-frontend\"} | event_name=\"route.saved\" | mode=\"new\" | unwrap time_to_save_s [$__auto]) by (service_name)",
          "legendFormat": "time to save"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": { "mode": "fixed", "fixedColor": "green" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "red", "value": 120 }
            ]
          },
          "custom": {
            "drawStyle": "points",
            "pointSize": 8,
            "showPoints": "always",
            "thresholdsStyle": { "mode": "line" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "hidden", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      }
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Recent frontend errors",
      "description": "Uncaught errors, unhandled rejections and React render errors. Expand a line for its stack trace and session ID; the trace_id links to Tempo.",
      "gridPos": { "x": 0, "y": 38, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "range",
          "expr": "{service_name=\"steer-frontend\"} | severity_text=\"ERROR\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Backend (steer-backend)",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 48, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Request rate by route",
      "description": "Phoenix requests per second, by route and status. Requests that match no route aren't counted.",
      "gridPos": { "x": 0, "y": 49, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (http_route, http_response_status_code) (rate(steer_http_request_duration_ms_count{service_name=\"steer-backend\"}[$__rate_interval]))",
          "legendFormat": "{{http_route}} {{http_response_status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "showPoints": "never", "spanNulls": true } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Request duration by route",
      "description": "p50 and p95 Phoenix request duration, by route.",
      "gridPos": { "x": 12, "y": 49, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.5, sum by (le, http_route) (rate(steer_http_request_duration_ms_bucket{service_name=\"steer-backend\"}[$__rate_interval])))",
          "legendFormat": "p50 {{http_route}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(steer_http_request_duration_ms_bucket{service_name=\"steer-backend\"}[$__rate_interval])))",
          "legendFormat": "p95 {{http_route}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "showPoints": "never", "spanNulls": true } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Database query time",
      "description": "p50 and p95 Ecto query total time (queue, query and decode), by source table. Raw SQL, such as the health check's SELECT 1, has no table.",
      "gridPos": { "x": 0, "y": 57, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "label_replace(histogram_quantile(0.5, sum by (le, source) (rate(steer_db_query_duration_ms_bucket{service_name=\"steer-backend\"}[$__rate_interval]))), \"source\", \"(no table)\", \"source\", \"\")",
          "legendFormat": "p50 {{source}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "label_replace(histogram_quantile(0.95, sum by (le, source) (rate(steer_db_query_duration_ms_bucket{service_name=\"steer-backend\"}[$__rate_interval]))), \"source\", \"(no table)\", \"source\", \"\")",
          "legendFormat": "p95 {{source}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "showPoints": "never", "spanNulls": true } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "BEAM memory",
      "description": "Memory the Phoenix VM uses, by kind.",
      "gridPos": { "x": 12, "y": 57, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (kind) (steer_vm_memory_bytes{service_name=\"steer-backend\"})",
          "legendFormat": "{{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "showPoints": "never", "spanNulls": true } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    }
  ]
}
